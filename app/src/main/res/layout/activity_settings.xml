<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:background="#161B22">

        <ImageButton
            android:id="@+id/btnSettingsBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── Fullscreen launch ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#161B22"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fullscreen launch"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Use fullscreen mode when launch growtopia"
                        android:textColor="#8B949E"
                        android:textSize="12sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swFullscreen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ── MAC Address ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#161B22"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mac Address"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modify your mac address to login growtopia."
                    android:textColor="#8B949E"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etMac"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555D6B"
                    android:hint="XX:XX:XX:XX:XX:XX"
                    android:background="@null"
                    android:inputType="textCapCharacters"
                    android:textSize="14sp"
                    android:paddingBottom="4dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#30363D"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end">

                    <Button
                        android:id="@+id/btnRandMac"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Randomize"
                        android:textColor="#6E7BF2"
                        android:background="@null"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnSaveMac"
                        android:layout_width="100dp"
                        android:layout_height="36dp"
                        android:text="Save"
                        android:textColor="#FFFFFF"
                        android:background="#6E7BF2"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Setting GID ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#161B22"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Setting GID"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modify your GID to login growtopia."
                    android:textColor="#8B949E"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etGid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555D6B"
                    android:hint="xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx"
                    android:background="@null"
                    android:inputType="text"
                    android:textSize="13sp"
                    android:paddingBottom="4dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#30363D"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end">

                    <Button
                        android:id="@+id/btnRandGid"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Randomize"
                        android:textColor="#6E7BF2"
                        android:background="@null"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnSaveGid"
                        android:layout_width="100dp"
                        android:layout_height="36dp"
                        android:text="Save"
                        android:textColor="#FFFFFF"
                        android:background="#6E7BF2"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Setting RID ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#161B22"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Setting RID"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modify your RID (device identifier) to login growtopia."
                    android:textColor="#8B949E"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etRid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555D6B"
                    android:hint="32-character hex"
                    android:background="@null"
                    android:inputType="textCapCharacters"
                    android:textSize="13sp"
                    android:paddingBottom="4dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#30363D"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end">

                    <Button
                        android:id="@+id/btnRandRid"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Randomize"
                        android:textColor="#6E7BF2"
                        android:background="@null"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnSaveRid"
                        android:layout_width="100dp"
                        android:layout_height="36dp"
                        android:text="Save"
                        android:textColor="#FFFFFF"
                        android:background="#6E7BF2"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Spoof OpenGL ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#161B22"
                android:padding="16dp"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spoof OpenGL"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Report custom OpenGL version and extensions to growtopia."
                        android:textColor="#8B949E"
                        android:textSize="12sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swOpenGL"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- OpenGL fields (shown only when toggle is on) -->
            <LinearLayout
                android:id="@+id/layoutOpenGLFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- OpenGL Version -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#161B22"
                    android:padding="16dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OpenGL Version"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Custom OpenGL Version for Growtopia."
                        android:textColor="#8B949E"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etOglVersion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:background="@null"
                        android:inputType="text"
                        android:textSize="14sp"
                        android:paddingBottom="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#30363D"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnSaveOglVersion"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Save"
                        android:textColor="#FFFFFF"
                        android:background="#6E7BF2"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- OpenGL Extensions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#161B22"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OpenGL Extensions"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Custom OpenGL Extension for Growtopia."
                        android:textColor="#8B949E"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etOglExtensions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:background="@null"
                        android:inputType="textMultiLine"
                        android:minLines="4"
                        android:gravity="top"
                        android:textSize="13sp"
                        android:paddingBottom="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#30363D"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnSaveOglExtensions"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Save"
                        android:textColor="#FFFFFF"
                        android:background="#6E7BF2"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- bottom padding -->
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
