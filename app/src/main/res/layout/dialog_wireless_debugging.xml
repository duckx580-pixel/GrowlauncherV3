<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#171522">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:contentDescription="The Rare Owl logo"
            android:scaleType="centerInside"
            android:src="@drawable/ic_rare_owl_logo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Wireless Debugging Sync"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Step 1: Turn on Developer Options and enable Wireless Debugging in your Android system settings.\n\nStep 2: Tap ‘Pair Device’ and enter the Wi-Fi pairing code and port shown on your screen.\n\nStep 3: Once connected, the launcher will automatically sync your save.dat file on launch."
            android:textColor="#E5E1F5"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/wirelessStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Wireless Debugging is ready to pair."
            android:textColor="#AAA4C0"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/wirelessPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="Wireless Debugging pairing port"
            android:inputType="number"
            android:maxLength="5"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAA4C0" />

        <EditText
            android:id="@+id/wirelessPairingCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Wi-Fi pairing code"
            android:inputType="number"
            android:maxLength="12"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAA4C0" />

        <Button
            android:id="@+id/wirelessConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Pair and sync save.dat" />

        <Button
            android:id="@+id/wirelessDismiss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel" />
    </LinearLayout>
</ScrollView>
