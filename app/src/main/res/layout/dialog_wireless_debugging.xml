<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#171522">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:contentDescription="The Rare Owl logo"
            android:scaleType="centerInside"
            android:src="@drawable/ic_rare_owl_logo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Wireless Debugging powerkuy"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Step 1: Turn on Developer Options and enable Wireless Debugging in your Android system settings.\n\nStep 2: Tap ‘Pair device with pairing code’ in Android Settings. This app will automatically find its pairing service.\n\nStep 3: When the service appears, a verification prompt will ask for the six-digit code. After pairing, the launcher will extract save.dat and unlock Growtopia."
            android:textColor="#E5E1F5"
            android:textSize="14sp" />

        <Button
            android:id="@+id/wirelessOpenSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Open Wireless Debugging settings" />

        <Button
            android:id="@+id/wirelessDismiss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel" />
    </LinearLayout>
</ScrollView>
