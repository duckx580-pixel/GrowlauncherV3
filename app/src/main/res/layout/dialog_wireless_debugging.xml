<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#171522">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:contentDescription="The Rare Owl logo"
            android:scaleType="centerInside"
            android:src="@drawable/ic_rare_owl_logo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Wireless Debugging powerkuy"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Step 1: Turn on Developer Options and enable Wireless Debugging in your Android system settings.\n\nStep 2: Tap ‘Pair device with pairing code’. Keep that system screen open and copy its IP address, port, and six-digit Wi-Fi pairing code below.\n\nStep 3: Once connected, the launcher will automatically unlock higher powerful modmenu."
            android:textColor="#E5E1F5"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/wirelessStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Enter the IP address, pairing port, and six-digit code shown by Android. Keep the pairing screen open while pairing."
            android:textColor="#AAA4C0"
            android:textSize="13sp" />


        <Button
            android:id="@+id/wirelessOpenSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Open Wireless Debugging settings" />

        <EditText
            android:id="@+id/wirelessHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="IP address (for example, 192.168.1.20)"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAA4C0" />

        <EditText
            android:id="@+id/wirelessPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pairing port (for example, 42015)"
            android:inputType="number"
            android:maxLength="5"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAA4C0" />

        <EditText
            android:id="@+id/wirelessPairingCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Six-digit Wi-Fi pairing code"
            android:inputType="number"
            android:maxLength="6"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAA4C0" />

        <Button
            android:id="@+id/wirelessConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Pair with entered details and sync save.dat" />

        <Button
            android:id="@+id/wirelessDismiss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel" />
    </LinearLayout>
</ScrollView>
